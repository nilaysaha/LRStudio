rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUser(data) {
      return data.id is string &&
        data.id == request.auth.uid &&
        data.email is string &&
        data.email.size() > 0 &&
        data.email.size() <= 254 &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 2048));
    }

    // Project validation
    function isValidProject(data, userId) {
      return data.id is string &&
        isValidId(data.id) &&
        data.userId is string &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('templateId' in data) || (data.templateId is string && data.templateId.size() <= 128)) &&
        (!('templateTag' in data) || (data.templateTag is string && data.templateTag.size() <= 64)) &&
        data.createdAt is number &&
        data.updatedAt is number;
    }

    // User Media validation
    function isValidMedia(data, userId) {
      return data.id is string &&
        isValidId(data.id) &&
        data.userId is string &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 150 &&
        data.type in ['image', 'video'] &&
        data.url is string &&
        data.url.size() > 0 &&
        (!('duration' in data) || (data.duration is number && data.duration >= 0)) &&
        (!('source' in data) || (data.source is string && data.source.size() <= 50));
    }

    // Custom Preset validation
    function isValidPreset(data, userId) {
      return data.id is string &&
        isValidId(data.id) &&
        data.userId is string &&
        data.userId == userId &&
        data.userId == request.auth.uid &&
        data.name is string &&
        data.name.size() > 0 &&
        data.name.size() <= 100 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 50)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.adjustments is map;
    }

    // User document rules
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Strict PII protection, no user collection scraping
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) &&
        incoming().id == existing().id &&
        incoming().email == existing().email;
      allow delete: if isOwner(userId);

      // Projects subcollection
      match /projects/{projectId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(projectId) && isValidProject(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId &&
          incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId) && isValidId(projectId);
      }

      // Media library subcollection
      match /media/{mediaId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(mediaId) && isValidMedia(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(mediaId) && isValidMedia(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(mediaId);
      }

      // Custom presets subcollection
      match /presets/{presetId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(presetId) && isValidPreset(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(presetId) && isValidPreset(incoming(), userId) &&
          incoming().id == existing().id &&
          incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(presetId);
      }
    }
  }
}
